<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty
        scope="context"
        name="NOMBRE_APP"
        source="spring.application.name"
        defaultValue="inventario-service"/>

    <springProperty
        scope="context"
        name="ARCHIVO_LOG"
        source="logging.file.name"
        defaultValue="target/logs/${NOMBRE_APP}.log"/>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <appender name="ARCHIVO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${ARCHIVO_LOG}</file>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>target/logs/${NOMBRE_APP}.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <root level="INFO">
        <appender-ref ref="ARCHIVO"/>
    </root>
</configuration>
